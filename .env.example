# ============================================================
# CantoBar POS - variables de entorno
# Copiá este archivo a .env y completá tus credenciales:
#   cp .env.example .env
#
# ⚠️  NUNCA subas .env a un repositorio (ya está en .gitignore).
# Las keys "anon" son públicas por diseño (van embebidas en el
# bundle del navegador); lo importante es que NUNCA uses una
# key "service_role" acá.
# ============================================================

# --- Base de datos propia de este cantobar ---
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# --- Base de datos CENTRAL de licencias (panel de administración) ---
# Distinta del Supabase de arriba: la usás para controlar el estado
# de suscripción de TODOS tus clientes.
VITE_ADMIN_SUPABASE_URL=https://TU-ADMIN-PROYECTO.supabase.co
VITE_ADMIN_SUPABASE_ANON_KEY=tu-anon-key-publica

# ID de la fila en la tabla "projects" que identifica a ESTE cliente/instancia
VITE_PROJECT_ID=tu-project-id-uuid
